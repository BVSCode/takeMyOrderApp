# Copy to .env for local development. In production set these on the host.
NODE_ENV=development
PORT=3000

# MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=mongodb://localhost:27017/TakeMyOrder

# Deployed frontend origin, no trailing slash. Used for CORS, the OAuth
# redirect after login, and the menu link embedded in restaurant QR codes.
FRONTEND_BASE_URL=http://localhost:8080
# Optional extra allowed origins, comma separated (preview URLs, custom domain)
# CORS_ORIGINS=https://preview.example.com,https://www.example.com

# Google OAuth 2.0 client (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI on the Google client
CALLBACK_URL=http://localhost:3000/auth/google/callback

# Long random string used to sign session JWTs
JWT_SECRET=

# Optional: when set, /api/v1/auth/admin/signup requires this invite code
# ADMIN_SIGNUP_CODE=
